{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VerificationExecution",
  "description": "Schema for verification.json (Machine-attested test execution results)",
  "type": "object",
  "required": ["ticket_key", "timestamp", "all_passed", "pre_checks", "post_checks"],
  "properties": {
    "ticket_key": { "type": "string", "pattern": "^[A-Z]+-[0-9]+$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "all_passed": { "type": "boolean" },
    "pre_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "command", "exit_code", "passed", "output_snippet"],
        "properties": {
          "name": { "type": "string" },
          "command": { "type": "string" },
          "exit_code": { "type": "integer" },
          "passed": { "type": "boolean" },
          "output_snippet": { "type": "string" }
        }
      }
    },
    "post_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "command", "exit_code", "passed", "output_snippet"],
        "properties": {
          "name": { "type": "string" },
          "command": { "type": "string" },
          "exit_code": { "type": "integer" },
          "passed": { "type": "boolean" },
          "output_snippet": { "type": "string" }
        }
      }
    }
  }
}
