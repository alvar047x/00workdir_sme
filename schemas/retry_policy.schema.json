{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Retry Policy Schema",
  "description": "Retry strategies for different operation types",
  "type": "object",
  "required": ["version", "retry_policy"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "retry_policy": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["max_attempts", "backoff_ms"],
        "properties": {
          "max_attempts": {
            "type": "integer",
            "minimum": 1,
            "description": "Maximum retry attempts"
          },
          "backoff_ms": {
            "type": "array",
            "items": { "type": "integer", "minimum": 0 },
            "description": "Backoff delays in ms for each attempt"
          },
          "retry_on_errors": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Error types to retry on"
          },
          "dont_retry_on_errors": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Error types to never retry"
          },
          "escalation_message": {
            "type": "string",
            "description": "Message to show user after max retries exceeded"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
