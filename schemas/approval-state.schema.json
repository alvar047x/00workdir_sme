{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ApprovalState",
  "description": "Schema for approval-state.json (Tamper-evident human and system sign-off ledger)",
  "type": "object",
  "required": ["ticket_key", "approvals"],
  "properties": {
    "ticket_key": { "type": "string", "pattern": "^[A-Z]+-[0-9]+$" },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["phase", "approver", "timestamp", "target_hash", "status"],
        "properties": {
          "phase": { "type": "string", "enum": ["plan_review", "pre_apply", "post_apply_verification", "pre_close"] },
          "approver": { "type": "string" },
          "timestamp": { "type": "string", "format": "date-time" },
          "target_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "status": { "type": "string", "enum": ["APPROVED", "REJECTED", "PENDING"] },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
