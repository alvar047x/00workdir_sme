{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "execution-manifest.schema.json",
  "title": "Execution Manifest",
  "description": "Rigid execution manifest minted by AI during plan phase. Validated by reaper before any shell execution.",
  "type": "object",
  "required": ["schema_version", "ticket", "execution", "expected_outcomes", "high_risk_flags", "scout_proof"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "ticket": {
      "type": "object",
      "required": ["key", "summary", "type", "ecr_migration", "priority"],
      "additionalProperties": false,
      "properties": {
        "key":           { "type": "string", "pattern": "^DVPS-[0-9]+$" },
        "summary":       { "type": "string", "minLength": 10 },
        "type":          { "type": "string", "enum": ["ecr_migration","azure_infra","aws_infra","cicd","k8s","security","hospital"] },
        "ecr_migration": { "type": "boolean" },
        "priority":      { "type": "string", "enum": ["blocker","critical","major","minor","trivial"] },
        "blocked_by":    { "type": "string", "pattern": "^DVPS-[0-9]+$" }
      }
    },
    "execution": {
      "type": "object",
      "required": ["repo", "target_branch", "environment", "working_dir", "commit_message", "lock_timeout_seconds"],
      "additionalProperties": false,
      "properties": {
        "repo":           { "type": "string", "enum": ["silvercloud-web-infra","silvercloud-web","azure_titan","cvg-titan-input","terraform-aws-pexip-common","central-ecr-image-bom","silvercloud-central-cicd","hospital"] },
        "target_branch":  { "type": "string", "minLength": 1 },
        "feature_branch": { "type": "string", "pattern": "^(DVPS-[0-9]+-|feature/|fix/).+" },
        "environment":    { "type": "string", "enum": ["build","qa-aws","stage-aws","prod-au","prod-ca","prod-ie","prod-uk","prod-us","qa","stg","prod"] },
        "working_dir":    { "type": "string", "pattern": "^~/vscode/clonedRepos/.+" },
        "commit_message": { "type": "string", "pattern": "^(feat|fix|chore|refactor|docs|test)\\(DVPS-[0-9]+\\): .{10,}" },
        "lock_timeout_seconds": { "type": "integer", "minimum": 30, "maximum": 3600 },
        "dry_run_command": { "type": "string", "minLength": 1 },
        "apply_command":   { "type": "string", "minLength": 1 }
      }
    },
    "expected_outcomes": {
      "type": "object",
      "required": ["adds", "changes", "destroys", "rationale"],
      "additionalProperties": false,
      "properties": {
        "adds":      { "type": "integer", "minimum": 0 },
        "changes":   { "type": "integer", "minimum": 0 },
        "destroys":  { "type": "integer", "minimum": 0 },
        "rationale": { "type": "string", "minLength": 20 }
      }
    },
    "high_risk_flags": {
      "type": "object",
      "required": ["has_destroy", "has_iam_change", "has_db_change", "is_production", "waiting_for_input"],
      "additionalProperties": false,
      "properties": {
        "has_destroy":       { "type": "boolean" },
        "has_iam_change":    { "type": "boolean" },
        "has_db_change":     { "type": "boolean" },
        "is_production":     { "type": "boolean" },
        "waiting_for_input": { "type": "boolean" }
      }
    },
    "scout_proof": {
      "type": "object",
      "required": ["sso_verified", "sso_identity_arn", "affected_files", "ticket_constraints"],
      "additionalProperties": false,
      "properties": {
        "sso_verified":     { "type": "boolean", "const": true },
        "sso_identity_arn": { "type": "string", "pattern": "^arn:aws:sts::[0-9]+:assumed-role/.+" },
        "affected_files": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^(~/vscode/clonedRepos|\\./|/Users/).+\\.(tf|yaml|yml|json|py|sh|md)$" }
        },
        "ticket_constraints": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["constraint", "source", "value"],
            "additionalProperties": false,
            "properties": {
              "constraint": { "type": "string", "minLength": 5 },
              "source":     { "type": "string", "enum": ["jira_ticket","repo_ops_file","wiki","context_manifest"] },
              "value":      { "type": "string", "minLength": 5 }
            }
          }
        }
      }
    },
    "architectural_safety": {
      "type": "object",
      "description": "Verification that infrastructure replacement is architecturally sound",
      "properties": {
        "forces_replacement": { "type": "boolean" },
        "vendor_doc_url": { "type": "string", "format": "uri" },
        "replacement_justification": { "type": "string", "minLength": 10 },
        "simpler_mechanism_considered": { "type": "string" }
      }
    }
  },
  "allOf": [
    {
      "description": "ECR migration: minimum 4 constraints required",
      "if": { "properties": { "ticket": { "properties": { "type": { "const": "ecr_migration" } } } }, "required": ["ticket"] },
      "then": { "properties": { "scout_proof": { "properties": { "ticket_constraints": { "minItems": 4 } } } } }
    },
    {
      "description": "Azure infra: minimum 3 constraints required",
      "if": { "properties": { "ticket": { "properties": { "type": { "const": "azure_infra" } } } }, "required": ["ticket"] },
      "then": { "properties": { "scout_proof": { "properties": { "ticket_constraints": { "minItems": 3 } } } } }
    },
    {
      "description": "Production environment: is_production and waiting_for_input must be true",
      "if": { "properties": { "execution": { "properties": { "environment": { "enum": ["prod-au","prod-ca","prod-ie","prod-uk","prod-us","prod"] } } } }, "required": ["execution"] },
      "then": { "properties": { "high_risk_flags": { "properties": { "is_production": { "const": true }, "waiting_for_input": { "const": true } } } } }
    },
    {
      "description": "Any destroys: has_destroy and waiting_for_input must be true",
      "if": { "properties": { "expected_outcomes": { "properties": { "destroys": { "minimum": 1 } } } }, "required": ["expected_outcomes"] },
      "then": { "properties": { "high_risk_flags": { "properties": { "has_destroy": { "const": true }, "waiting_for_input": { "const": true } } } } }
    },
    {
      "description": "Forces replacement requires vendor doc URL and replacement justification",
      "if": { "properties": { "architectural_safety": { "properties": { "forces_replacement": { "const": true } } } }, "required": ["architectural_safety"] },
      "then": { "properties": { "architectural_safety": { "required": ["vendor_doc_url", "replacement_justification"] } } }
    }
  ]
}
