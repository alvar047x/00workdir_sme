{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SessionContext",
  "description": "Schema for session-context.json (Deterministic session-end chat summary)",
  "type": "object",
  "required": ["session_id", "ticket_key", "timestamp", "summary", "decisions_made", "pending_actions", "active_branch"],
  "properties": {
    "session_id": { "type": "string" },
    "ticket_key": { "type": "string", "pattern": "^[A-Z]+-[0-9]+$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "summary": { "type": "string", "minLength": 20 },
    "active_branch": { "type": "string" },
    "decisions_made": {
      "type": "array",
      "items": { "type": "string" }
    },
    "commands_executed": {
      "type": "array",
      "items": { "type": "string" }
    },
    "pending_actions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "blockers": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
