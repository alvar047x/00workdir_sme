{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Validators Schema",
  "description": "Precondition validators and their checks",
  "type": "object",
  "required": ["version", "validators"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "validators": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["check", "fail_message", "remediation"],
        "properties": {
          "check": {
            "type": "string",
            "description": "Description of check to perform"
          },
          "fail_message": {
            "type": "string",
            "description": "Message when check fails"
          },
          "remediation": {
            "type": "string",
            "description": "Instructions to fix the failure"
          },
          "timeout_ms": {
            "type": "integer",
            "minimum": 1000,
            "description": "Timeout for this validator in ms"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
