          "limit": {
            "type": "integer",
            "description": "Rows, default 10",
            "maximum": 50
          },
          "repo": {
            "type": "string",
            "description": "Manifest slug. Omit to resolve from the cwd's origin URL hash. Needed because the Kiro workspace is multi-root and the cwd is usually 00workdir."
          }
