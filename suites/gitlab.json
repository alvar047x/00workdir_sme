      "outputs": {
        "verdict": {
          "type": "string",
          "description": "PASS, FAIL, HUMAN or RUNNING; always the first key"
        },
        "pipelines": {
          "type": "array",
          "description": "id, ref, status, url"
        }
      },
      "validator": {
        "kind": "exit_code",
        "pass_when": "exit 0"
      }
    },
