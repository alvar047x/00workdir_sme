{
  "suite": "gitlab",
  "schema": "schemas/suite-verb.schema.json",
  "evidence": "reports/audit-2026-09-18/01-atpy-inventory.md",
  "verbs": [
    {
      "name": "gather",
      "suite": "gitlab",
      "description": "Repo, MR and newest-pipeline state for a ticket key in one call, verdict first.",
      "input_schema": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "description": "Ticket key",
            "pattern": "^[A-Z]+-\\d+$"
          },
          "repo": {
            "type": "string",
            "description": "Manifest slug. Omit to resolve from the cwd's origin URL hash. Needed because the Kiro workspace is multi-root and the cwd is usually 00workdir."
          }
        },
        "required": [
          "key"
        ],
        "additionalProperties": false
      },
      "side_effect_class": "read",
      "required_bindings": [
        "repo.identity.remote_hash",
        "repo.ci_project_path",
        "system.gitlab.token_env",
        "repo.base_branch"
      ],
      "outputs": {
        "verdict": {
          "type": "string",
          "description": "PASS, FAIL, HUMAN or RUNNING; always the first key"
        },
        "branches": {
          "type": "array",
          "description": "local and remote branches carrying the key"
        },
        "mr": {
          "type": "object",
          "description": "iid, state, url, or null"
        },
        "pipeline": {
          "type": "object",
          "description": "id, status, url, or null"
        }
      },
      "validator": {
        "kind": "exit_code",
        "pass_when": "exit 0"
      }
    },
    {
      "name": "mr-prepare",
      "suite": "gitlab",
      "description": "Write the MR description file for the ticket and print the new-MR link and the drafted ticket comment; creates no MR.",
      "input_schema": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "description": "Ticket key",
            "pattern": "^[A-Z]+-\\d+$"
          },
          "from_file": {
            "type": "string",
            "description": "Path of the MR markdown, or - for stdin"
          },
          "title": {
            "type": "string",
            "description": "MR title"
          },
          "repo": {
            "type": "string",
            "description": "Manifest slug. Omit to resolve from the cwd's origin URL hash. Needed because the Kiro workspace is multi-root and the cwd is usually 00workdir."
          }
        },
        "required": [
          "key",
          "from_file"
        ],
        "additionalProperties": false
      },
      "side_effect_class": "write",
      "required_bindings": [
        "repo.identity.remote_hash",
        "repo.ci_project_path",
        "system.gitlab.token_env",
        "repo.mr_target_branch",
        "repo.base_branch"
      ],
      "outputs": {
        "verdict": {
          "type": "string",
          "description": "PASS, FAIL, HUMAN or RUNNING; always the first key"
        },
        "mr_file": {
          "type": "string",
          "description": "path written"
        },
        "new_mr_url": {
          "type": "string",
          "description": "prefilled GitLab new-MR link"
        }
      },
      "validator": {
        "kind": "exit_code",
        "pass_when": "exit 0 and mr_file exists"
      }
    },
    {
      "name": "watch",
      "suite": "gitlab",
      "description": "Watch one pipeline for one layer until plan or apply resolves; verdict first; never plays a job.",
      "input_schema": {
        "type": "object",
        "properties": {
          "pipeline": {
            "type": "string",
            "description": "Pipeline id or URL"
          },
          "layer": {
            "type": "string",
            "description": "Layer dir from the manifest"
          },
          "paths": {
            "type": "string",
            "description": "Comma list of changed paths, resolved to a layer"
          },
          "mr": {
            "type": "integer",
            "description": "MR iid whose changed paths resolve the layer"
          },
          "once": {
            "type": "boolean",
            "description": "One snapshot; exit 4 while running"
          },
          "until": {
            "enum": [
              "plan",
              "apply"
            ]
          },
          "repo": {
            "type": "string",
            "description": "Manifest slug. Omit to resolve from the cwd's origin URL hash. Needed because the Kiro workspace is multi-root and the cwd is usually 00workdir."
          }
        },
        "required": [
          "pipeline"
        ],
        "additionalProperties": false
      },
      "side_effect_class": "read",
      "required_bindings": [
        "repo.identity.remote_hash",
        "repo.ci_project_path",
        "system.gitlab.token_env",
        "repo.watch"
      ],
      "outputs": {
        "verdict": {
          "type": "string",
          "description": "PASS, FAIL, HUMAN or RUNNING; always the first key"
        },
        "layer": {
          "type": "string",
          "description": "resolved layer"
        },
        "plan_job": {
          "type": "object",
          "description": "status and summary line"
        },
        "apply_job": {
          "type": "object",
          "description": "status and summary line"
        }
      },
      "validator": {
        "kind": "exit_code",
        "pass_when": "exit 0 pass; 2 blocked or failed; 3 timeout; 4 still running (only with once)"
      }
    },
    {
      "name": "watch-derive",
      "suite": "gitlab",
      "description": "Print layer lines derived from the CI files for human approval into the manifest.",
      "input_schema": {
        "type": "object",
        "properties": {
          "repo": {
            "type": "string",
            "description": "Manifest slug. Omit to resolve from the cwd's origin URL hash. Needed because the Kiro workspace is multi-root and the cwd is usually 00workdir."
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "side_effect_class": "read",
      "required_bindings": [
        "repo.identity.remote_hash",
        "repo.ci_files"
      ],
      "outputs": {
        "verdict": {
          "type": "string",
          "description": "PASS, FAIL, HUMAN or RUNNING; always the first key"
        },
        "layers": {
          "type": "array",
          "description": "dir, plan_job, apply_job per layer"
        }
      },
      "validator": {
        "kind": "exit_code",
        "pass_when": "exit 0"
      }
    },
    {
      "name": "pipeline-list",
      "suite": "gitlab",
