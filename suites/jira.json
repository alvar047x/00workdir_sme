    {
      "name": "fetch",
      "suite": "jira",
      "description": "Fetch one ticket and write its snapshot under the ticket dir.",
      "input_schema": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "description": "Ticket key",
            "pattern": "^[A-Z]+-\\d+$"
          }
        },
        "required": [
          "key"
        ],
        "additionalProperties": false
      },
      "side_effect_class": "read",
      "required_bindings": [
        "system.atlassian.site"
      ],
      "outputs": {
        "verdict": {
          "type": "string",
          "description": "PASS, FAIL, HUMAN or RUNNING; always the first key"
        },
        "snapshot_dir": {
          "type": "string",
          "description": "tickets/KEY path"
        },
        "status": {
          "type": "string",
          "description": "current status"
        }
      },
      "validator": {
        "kind": "exit_code",
        "pass_when": "exit 0 and snapshot files exist"
      }
    },
